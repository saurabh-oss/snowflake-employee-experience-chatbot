# ============================================================================
# EX Chatbot — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.
# ============================================================================

# ── Snowflake Connection ──────────────────────────────────────────────────
# Your Snowflake account identifier.
# New-style org accounts: ORGNAME-ACCOUNTNAME  (e.g., MYORG-ABC12345)
# Legacy format: accountname.region           (e.g., abc12345.us-east-1)
SNOWFLAKE_ACCOUNT=your-org-accountname

# Your Snowflake username (the one you log in to app.snowflake.com with)
SNOWFLAKE_USER=your-username

# Path to the RSA private key file used for key-pair authentication.
# Generate with: openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt -out snowflake_private_key.pem
# Register the public key: ALTER USER <you> SET RSA_PUBLIC_KEY='<public-key-contents>';
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/snowflake_private_key.pem

# Warehouse for Cortex inference (created by 01_setup_database.sql)
SNOWFLAKE_WAREHOUSE=EX_CORTEX_WH

# Database and schema
SNOWFLAKE_DATABASE=EX_CHATBOT
SNOWFLAKE_SCHEMA=HR_DATA

# Stage path to the Cortex Analyst semantic model YAML
SEMANTIC_MODEL_STAGE=@EX_CHATBOT.PUBLIC.SEMANTIC_MODELS/04_semantic_model.yaml

# Role to use. EX_CHATBOT_APP is the least-privilege app role.
# Use ACCOUNTADMIN temporarily if you hit permission issues during initial setup.
SNOWFLAKE_ROLE=EX_CHATBOT_APP

# ── Cortex AI Settings ───────────────────────────────────────────────────
# LLM for COMPLETE calls (fallback / action synthesis).
# Confirmed working (Oregon / AWS us-west-2): llama3.1-70b, mistral-large2
# Check availability: https://docs.snowflake.com/en/user-guide/snowflake-cortex/llm-functions#region-availability
CORTEX_MODEL=llama3.1-70b

# LLM for the Cortex Agents REST API (/api/v2/cortex/agent:run).
# Defaults to CORTEX_MODEL above. If your region only supports claude-3-5-sonnet
# for the Agents API, override here:
# CORTEX_AGENTS_MODEL=claude-3-5-sonnet

# ── Application Settings ────────────────────────────────────────────────
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
